{"question": "S5", "question_version": "v1.0", "first_seen": "R1", "last_seen": "R1", "status": "유효", "replaces": null, "check_flags": [], "id": "S5-I-001", "type": "해석", "importance": 3, "target": "예산·접점의 최대 승자", "direction": "강화", "statement": "영업·마케팅 AI 예산과 고객 접점을 가장 크게 확보한 곳은 광고 플랫폼이다. Meta Advantage+ 하나가 연환산 750억 달러로, 주요 CRM의 AI 매출(Agentforce 15억 달러)보다 50배 크다. AI가 광고 상품 안에 들어 있어 별도 구매 결정 없이 퍼진다.", "basis": ["S5-M-001", "S5-M-002"]}
