{"question": "C4", "question_version": "v1.0", "first_seen": "R1", "last_seen": "R1", "status": "유효", "replaces": null, "check_flags": [], "id": "C4-M-004", "type": "지표", "indicator": "C4-T4", "importance": 2, "statement": "AI 기능을 써 본 한국 소비자는 생활가전 51%, 주방가전 39.1%로 1년 새 각각 5.9%p, 6.6%p 늘었다.", "value": 51, "unit": "% (생활가전)", "as_of": "2026-03", "region": "KR", "definition": "오픈서베이, AI 기능 경험률", "extra": {"kitchen": "39.1%"}, "sources": [{"url": "https://www.hankyung.com/article/202604012347g", "publisher": "한국경제 (오픈서베이 AI 가전 트렌드 리포트 2026)", "date": "2026-04-01", "grade": "B", "key": "hk_opensurvey"}], "verified": true}
